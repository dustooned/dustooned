---
import { HERO } from "../config/site";

const { videoSrc, posterImage } = HERO;
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    {
      videoSrc ? (
        <video class="hero__video" autoplay muted loop playsinline poster={posterImage || undefined}>
          <source src={videoSrc} />
        </video>
      ) : (
        <div class="hero__placeholder"></div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: min(80vh, 640px);
    overflow: hidden;
    margin-top: calc(var(--space-7) * -1);
    margin-bottom: var(--space-7);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video,
  .hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    background: linear-gradient(120deg, var(--color-accent), var(--color-secondary), var(--color-accent));
    background-size: 220% 220%;
    animation: hero-drift 16s ease-in-out infinite;
  }

  @keyframes hero-drift {
    0%,
    100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__placeholder {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .hero {
      margin-top: calc(var(--space-8) * -1);
    }
  }
</style>
